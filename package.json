{
  "name": "@absolutejs/agents-mcp",
  "version": "0.2.2",
  "description": "Search verified agents and production agent-first AbsoluteJS packages from any MCP client.",
  "mcpName": "io.github.absolutejs/agents",
  "type": "module",
  "license": "MIT",
  "author": "Alex Kahn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/absolutejs/agents-mcp.git"
  },
  "homepage": "https://github.com/absolutejs/agents-mcp",
  "bugs": {
    "url": "https://github.com/absolutejs/agents-mcp/issues"
  },
  "bin": {
    "absolute-agents-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "changelog.json",
    "dist",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && absolute-manifest emit",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:package": "bun run typecheck && bun run test && bun run build && bun scripts/check-package.ts && absolute-changelog check",
    "release": "bun run check:package && npm publish --access public",
    "prepublishOnly": "absolute-changelog check"
  },
  "dependencies": {
    "@absolutejs/manifest": "^0.9.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sinclair/typebox": "^0.34.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@absolutejs/changelog": "^0.5.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "absolutejs",
    "mcp",
    "agents",
    "ai-agents",
    "discovery",
    "registry"
  ],
  "absolutejs": {
    "manifestContract": 2
  }
}
